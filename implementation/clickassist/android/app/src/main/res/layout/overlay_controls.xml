<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/overlayCompactButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_compact_background"
        android:contentDescription="Open ClickAssist overlay controls"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/overlayCompactIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Current automation state"
            android:src="@android:drawable/ic_media_play"
            android:tint="#EAF8FF" />

        <TextView
            android:id="@+id/overlayCompactStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:text="READY"
            android:textColor="#EAF8FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlayExpandedBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_background"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/overlayStatusPanel"
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlayStatusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:text="Ready"
                android:textColor="#12C8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Configure first"
                android:textColor="#EAF8FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlaySpeedLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="No speed set"
                android:textColor="#93A4C8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/overlayPickerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Picker idle"
                android:textColor="#93A4C8"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayActionPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/overlayPlayButtonContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/overlay_button_active_background">

                <ImageView
                    android:id="@+id/overlayPlayButton"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Start automation"
                    android:tint="#081221" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/overlayStopButtonContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/overlay_button_background">

                <ImageView
                    android:id="@+id/overlayStopButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Stop automation"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/overlaySettingsButtonContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/overlay_button_background">

                <ImageView
                    android:id="@+id/overlaySettingsButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Open ClickAssist"
                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="#93A4C8" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
